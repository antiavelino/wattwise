# ==============================================================================
# WattWise — Smart Energy Intelligence SaaS
# Exemplo de Variáveis de Ambiente (.env.example)
# ==============================================================================
# Copie este arquivo para `.env.local` para desenvolvimento local.
# NUNCA faça commit de arquivos `.env` ou `.env.local` com chaves reais.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VARIÁVEIS PÚBLICAS DO CLIENTE (Vite Frontend)
# Estas variáveis possuem o prefixo `VITE_` e são expostas ao navegador.
# Use APENAS a chave pública `anon` do Supabase (protegida por Row Level Security).
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica
VITE_APP_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. SEGREDOS EXCLUSIVOS DE SERVIDOR (Supabase Edge Functions / CLI Secrets)
# ⚠️ AVISO CRÍTICO DE SEGURANÇA / CRITICAL SECURITY WARNING:
# NUNCA adicione o prefixo `VITE_` às variáveis abaixo!
# Configure-as via `supabase secrets set` ou no painel de Edge Functions.
# ------------------------------------------------------------------------------

# Chave administrativa do Supabase (uso exclusivo dentro das Edge Functions)
SUPABASE_SERVICE_ROLE_KEY=

# Serviço de E-mail Transacional (opcional — Convites de Equipe via team-invite)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@wattwise.com.br
